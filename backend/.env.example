PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/bima-mitra
MONGODB_ATLAS_URI=your_mongodb_atlas_connection_string_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d

# Email Service (Choose one)
# Mailgun
MAILGUN_DOMAIN=your_mailgun_domain_here
MAILGUN_API_KEY=your_mailgun_api_key_here

# SendGrid (Alternative)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@thebimamitra.com

# Admin Email
ADMIN_EMAIL=admin@thebimamitra.com

# Cloudinary (For image uploads)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:3000,https://www.thebimamitra.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
